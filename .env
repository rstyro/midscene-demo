# Midscene 模型配置（以阿里云百炼 Qwen-VL 为例）
# MIDSCENE_MODEL_BASE_URL="https://open.bigmodel.cn/api/paas/v4/" # 或 https://api.z.ai/api/paas/v4
# MIDSCENE_MODEL_API_KEY="115835632774493e8d9967f39b0979fa.XmM4Ltu1spmXIkqW"
# MIDSCENE_MODEL_NAME="GLM-4.6V-Flash" # GLM-5V-Turbo 的对应模型名为 "glm-5v-turbo"
# MIDSCENE_MODEL_FAMILY="glm-v"
# MIDSCENE_MODEL_REASONING_ENABLED="false"

# 默认视觉模型
MIDSCENE_MODEL_BASE_URL="https://ark.cn-beijing.volces.com/api/coding/v3"
MIDSCENE_MODEL_API_KEY=${ARK_API_KEY}
MIDSCENE_MODEL_NAME="doubao-seed-2.0-pro"
MIDSCENE_MODEL_FAMILY="doubao-seed"
MIDSCENE_MODEL_REASONING_ENABLED="false"



# 负责任务规划（aiAct / ai 里的 Planning）
MIDSCENE_PLANNING_MODEL_BASE_URL="https://ark.cn-beijing.volces.com/api/coding/v3"
MIDSCENE_PLANNING_MODEL_API_KEY=${ARK_API_KEY}
MIDSCENE_PLANNING_MODEL_NAME="doubao-seed-2.0-pro"
MIDSCENE_PLANNING_MODEL_FAMILY="doubao-seed"

# 负责数据提取、断言与页面理解（aiQuery / aiAsk / aiAssert 等）
MIDSCENE_INSIGHT_MODEL_BASE_URL="https://ark.cn-beijing.volces.com/api/coding/v3"
MIDSCENE_INSIGHT_MODEL_API_KEY=${ARK_API_KEY}
MIDSCENE_INSIGHT_MODEL_NAME="doubao-seed-2.0-lite"
MIDSCENE_INSIGHT_MODEL_FAMILY="doubao-seed"

# 服务端口
PORT=3000

# 可选：浏览器是否 headless（生产环境建议 true，开发时可 false 看到界面）
HEADLESS=false